# Dependencies
node_modules/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Build output
dist/
dist-ssr/
# The review site build (npm run build:review-site)
dist-review/
.wrangler/

# Test output
playwright-report/
test-results/
blob-report/
coverage/

# Secrets. Only .env.example is committed (names, never values).
.env
.env.*
!.env.example
.dev.vars*
*.local

# Switzer font files: the ITF Free Font License forbids offering them through a
# public repository. Fetched by scripts/ci/fetch-private-fonts.ts (docs/fonts.md).
src/assets/fonts/switzer/

# Generated by the v2 content pipeline when run locally
scripts/generate/out/

# Editors and OS
.vscode/*
.idea/
.DS_Store
Thumbs.db
*.log

# Factory worktrees
.worktrees/

# recording/ is a separate private repository, checked out in this folder. The
# session log hook in .claude/settings.json writes there; none of it belongs
# in the public repository.
recording/
