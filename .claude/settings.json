{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/recording/log-turn.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "factory-builder",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop-checks.ts\" worktrees",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
