{
  "name": "puhuscribe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:env-names && tsc -b && vite build && npm run check:built-secrets",
    "build:review-site": "node scripts/review-site/build.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:code": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check:env-names": "node scripts/security/check-env-names.ts",
    "check:built-secrets": "node scripts/security/check-built-secrets.ts",
    "cf-typegen": "wrangler types",
    "eval:speech": "vitest run scripts/eval/speech-golden.test.ts --silent=false --reporter=verbose",
    "eval:speech-wer": "node scripts/eval/speech-wer-cli.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "jose": "6.2.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lefthook": "2.2.2",
    "prettier": "^3.9.10",
    "supabase": "2.121.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
