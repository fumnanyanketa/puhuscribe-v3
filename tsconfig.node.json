{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Type safety */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "scripts/security",
    "scripts/ci",
    "scripts/v2-import",
    "scripts/hooks",
    "scripts/eval",
    "scripts/speech",
    "vitest.eval.config.ts",
    "tests",
    "e2e"
  ],
  /* The speaking feedback evals (scripts/eval/) and the fixture recorder
     (scripts/speech/), job 10-speaking-feedback, use the feedback rules,
     which use v2's grader: like the Worker, they type check against the v2
     engines project's declarations (tsconfig.engines.json). */
  "references": [{ "path": "./tsconfig.engines.json" }]
}
