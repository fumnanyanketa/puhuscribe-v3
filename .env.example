# Every setting PuhuScribe reads, with what it is for. Names only, never values.
#
# Local use: copy this file to .env.local (git ignores it) and paste TEST
# project values only. Vite and the Worker's local dev both read .env.local.
# Never start a secret's name with VITE_: Vite copies VITE_ variables into the
# browser files, and the build stops if one looks secret.

# Supabase test project "puhuscribe-test" (EU: West EU, Ireland, eu-west-1)
SUPABASE_URL=              # Project URL of the test project, https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=  # Test project publishable key (starts sb_publishable_). The Worker sends it; the browser never sees it
SUPABASE_DB_URL=           # Test project session pooler connection string, for database tests and scripts. Contains the database password

# The content pipeline (scripts/generate/, job 7-content-pipeline) runs at build
# time in the manual GitHub workflow "Content pipeline", which sets these from
# GitHub secrets and variables. Locally the tests use the fake providers and need
# none of them. The app and the Worker never read them.
AI_PROVIDER=               # anthropic (real drafting) or fake (recorded answers, for tests); read only by scripts/generate/providers/ai.py
AI_FAKE_RECORDING=         # With AI_PROVIDER=fake, the JSON file of recorded answers to replay
ANTHROPIC_API_KEY=         # Anthropic API key for drafting, the why lines and the judge. Only in GitHub secrets for the pipeline workflow
VOICE_PROVIDER=            # azure (real voices) or fake (silent test audio); read only by scripts/generate/providers/voice.py
AZURE_SPEECH_KEY=          # Azure Speech resource key. Only in GitHub secrets for the pipeline workflow
AZURE_SPEECH_REGION=       # The Speech resource's EU region, for example northeurope (a GitHub variable, not secret)
AZURE_SPEECH_TIER=         # The Speech resource's price tier: F0 is the free tier (a GitHub variable, not secret)

# GitHub repository secrets, used by the GitHub checks only. Never in .env.local.
# Set each one with: gh secret set NAME   (it asks for the value, so it never shows in chat)
#   CLOUDFLARE_API_TOKEN         A Cloudflare API token used only for Worker uploads
#   CLOUDFLARE_ACCOUNT_ID        Cloudflare account ID
#   SUPABASE_TEST_URL            Same value as SUPABASE_URL above
#   SUPABASE_TEST_PUBLISHABLE_KEY  Same value as SUPABASE_PUBLISHABLE_KEY above
#   SUPABASE_TEST_DB_URL         Same value as SUPABASE_DB_URL above
#   CF_ACCESS_CLIENT_ID          Client ID of the evaluator's Cloudflare Access service token
#   CF_ACCESS_CLIENT_SECRET      Client secret of that service token
#   ANTHROPIC_API_KEY            Anthropic API key, read only by the "Content pipeline" workflow
#   AZURE_SPEECH_KEY             Azure Speech key, read only by the "Content pipeline" workflow
# GitHub repository variables (not secret), set with: gh variable set NAME
#   AZURE_SPEECH_REGION          The Speech resource's EU region, for example northeurope
#   AZURE_SPEECH_TIER            F0 (the free tier)
#
# Worker secrets on puhuscribe-preview (set by the preview workflow from the
# GitHub secrets above): SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY.

# Design pages (job 5-design-system). Not a secret: it only switches pages on.
VITE_DESIGN_REFERENCE=     # Set to 1 to build in /design-reference and /sample/hear-it (the checks and previews do); leave empty for a normal build
