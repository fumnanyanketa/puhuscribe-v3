/**
 * Wrangler configuration for the PuhuScribe app.
 * One Worker serves the built app as static files and runs every /api/* route.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * The top level is the Worker named puhuscribe-preview: it only ever holds test
 * project secrets. The "production" environment below is the live Worker,
 * "aleksi", on https://meetaleksi.com (job go-live). It is built only by the
 * manual Live workflow (.github/workflows/live.yml), with CLOUDFLARE_ENV=production,
 * and only that workflow gives it the live project's settings.
 * Secrets never go in this file. Locally they come from .env.local; on Cloudflare
 * they are Worker secrets.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puhuscribe-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  // puhuscribe-preview.<subdomain>.workers.dev, plus one preview address per
  // version alias (<alias>-puhuscribe-preview...). Cloudflare Access guards both.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every /api/* route, the landing page "/" and the app's page routes under
    // /learn so the Worker can count an arrival, and /landing, the landing
    // file's own address, which redirects to "/" (job 17-landing-page). Counting is
    // factory/jobs/14-analytics/spec.md, "Done when" 3. Exactly the
    // list in worker/page-routes.ts (tests/analytics-rules.test.ts). Files are
    // never listed: they are served without running the Worker.
    "run_worker_first": [
      "/api/*",
      "/",
      "/learn",
      "/learn/session",
      "/learn/voice",
      "/learn/account",
      "/learn/account/*",
      "/learn/sign-in",
      "/learn/privacy",
      "/learn/feedback",
      "/learn/owner",
      "/landing",
    ],
  },
  // The owner page (job 14-analytics) needs OWNER_HOSTNAME,
  // OWNER_ACCESS_TEAM_DOMAIN and OWNER_ACCESS_AUD. They are set on the
  // production Worker at go live, never here: without them no hostname is
  // treated as the owner page's.
  "observability": {
    "enabled": true,
    // Cloudflare's own per-request logs are off: requests carry sign in
    // cookies, and Cloudflare does not document which request details those
    // logs keep. The Worker's own logs stay, and the Worker writes nothing
    // personal to them (factory/jobs/8-first-session/spec.md, "Done when" 19).
    "logs": {
      "invocation_logs": false,
    },
  },
  "upload_source_maps": true,
  "env": {
    // The live Worker (job go-live). Everything above is inherited (main,
    // compatibility_date, assets with run_worker_first, observability with the
    // invocation logs off, source maps) except what is set here. It has no
    // workers.dev address and no preview addresses, so meetaleksi.com is its
    // only address, and it is not behind Cloudflare Access. www.meetaleksi.com
    // is attached too, only so the Worker can send it to the apex
    // (CANONICAL_HOST, worker/canonical-host.ts). No secret is set here; the
    // live workflow passes them in a temporary file.
    "production": {
      "name": "aleksi",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "meetaleksi.com", "custom_domain": true },
        { "pattern": "www.meetaleksi.com", "custom_domain": true },
      ],
      "vars": {
        "CANONICAL_HOST": "meetaleksi.com",
      },
    },
  },
}
